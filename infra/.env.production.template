# ─── Database ────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME
DB_USER=rl_user
DB_NAME=alpaca_rl
DATABASE_URL=postgresql://rl_user:CHANGE_ME@postgres:5432/alpaca_rl
NATS_URL=nats://nats:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ─── MinIO / S3 ─────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=alpaca-rl-artifacts
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME

# ─── Alpaca API (paper trading) ─────────────────────────────────────
ALPACA_API_KEY=CHANGE_ME
ALPACA_API_SECRET=CHANGE_ME
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets

# ─── Kaggle ──────────────────────────────────────────────────────────
KAGGLE_USERNAME=CHANGE_ME
KAGGLE_API_TOKEN=CHANGE_ME

# ─── Grafana ─────────────────────────────────────────────────────────
GF_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_EXTERNAL_URL=https://grafana.nelsonjohns.com

# ─── Keycloak ────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.nelsonjohns.com
KEYCLOAK_REALM=alpaca-rl-suite
KEYCLOAK_CLIENT_ID=alpaca-rl-web-ui
KC_SERVICE_CLIENT_ID=temporal-worker
KC_SERVICE_CLIENT_SECRET=CHANGE_ME

# ─── Risk Controls ──────────────────────────────────────────────────
MAX_DAILY_LOSS_USD=1000
MAX_POSITION_SIZE_PCT=0.10
KILL_SWITCH_ENABLED=false
TRADING_MODE=paper
